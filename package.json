{
	"name": "@0xbuff/documentation",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Guides, examples, and API references for 0xBUFF tools.",
	"homepage": "https://docs.0xbuff.com/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xbuffdev/documentation.git"
	},
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"deploy:staging": "pnpm build:staging && wrangler deploy",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "wrangler types && react-router typegen && tsc",
		"test": "node --test scripts/*.test.mjs && node --experimental-strip-types --test src/lib/*.test.ts",
		"bundle:report": "node scripts/report-bundle.mjs",
		"build:staging": "node scripts/build-env.mjs staging",
		"seed:content": "node scripts/seed-content.mjs"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/orbitron": "^5.3.0",
		"@react-router/serve": "^8",
		"@types/mdx": "^2.0.14",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fumadocs-core": "^16.15.4",
		"fumadocs-mdx": "^15.4.0",
		"fumadocs-ui": "^16.15.4",
		"isbot": "^5.1.36",
		"katex": "^0.16.21",
		"lucide-react": "^1.39.0",
		"mermaid": "^11.16.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8",
		"react-router-auto-routes": "^1.0.0",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"shadcn": "^4.21.0",
		"tailwind-merge": "^3.6.0",
		"takumi-js": "^2.13.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3",
		"@0xbuff/content-contract": "npm:@0xbuffdev/content-contract@0.1.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.67.0",
		"@react-router/dev": "^8",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"wrangler": "4.156.1"
	},
	"packageManager": "pnpm@11.2.2"
}
